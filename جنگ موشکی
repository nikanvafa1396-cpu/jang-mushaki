<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">

<title>💻 nikanbot ☠️ | DARK SHOOTER</title>

<style>
* {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

html, body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    font-family: Tahoma, Arial, sans-serif;
    background: #050509;
    color: white;
}

body {
    min-height: 100vh;
    min-height: 100dvh;
    overflow-x: hidden;
    background:
        radial-gradient(circle at 15% 20%, #ff003322, transparent 35%),
        radial-gradient(circle at 85% 80%, #7700ff33, transparent 40%),
        #050509;
}

button {
    font-family: inherit;
    cursor: pointer;
    touch-action: manipulation;
}

.screen {
    display: none;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    padding: 20px 0;
}

#menu {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    flex-direction: column;
    padding:
        max(18px, env(safe-area-inset-top))
        0
        max(20px, env(safe-area-inset-bottom));
}

.menuBox {
    width: 92%;
    max-width: 440px;
    padding: 25px 17px;
    margin: 0 auto;
    text-align: center;
    background: #0c0c16ee;
    border: 2px solid #ff1744;
    border-radius: 25px;
    box-shadow:
        0 0 25px #ff003344,
        0 0 60px #7700ff22;
    animation: appear .5s ease;
}

@keyframes appear {
    from {
        opacity: 0;
        transform: translateY(15px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.logo {
    font-size: clamp(27px, 7vw, 39px);
    font-weight: 900;
    margin-bottom: 12px;
    text-shadow: 0 0 12px #ff1744, 0 0 28px red;
}

.subtitle {
    color: #ff7188;
    font-size: 14px;
    line-height: 1.9;
    margin-bottom: 22px;
}

.btn {
    display: block;
    width: 100%;
    padding: 15px 10px;
    margin: 11px auto;
    border: 1px solid #ff4969;
    border-radius: 14px;
    color: white;
    font-size: 17px;
    font-weight: bold;
    background: linear-gradient(100deg, #b00028, #48005f);
    box-shadow: 0 0 15px #ff003322;
}

.btn:active {
    transform: scale(.97);
}

.gray {
    background: #191923;
    border-color: #55556b;
}

.version {
    margin-top: 22px;
    font-size: 11px;
    color: #85859b;
    line-height: 1.8;
}

#game {
    padding: 0;
    min-height: 100vh;
    min-height: 100dvh;
    position: fixed;
    inset: 0;
    background: #080810;
}

#arena {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
    touch-action: none;
}

#hud {
    position: absolute;
    z-index: 2;
    top: max(8px, env(safe-area-inset-top));
    left: 8px;
    right: 8px;
    display: flex;
    justify-content: space-between;
    gap: 5px;
    flex-wrap: wrap;
    font-size: 12px;
    pointer-events: none;
}

.hudBox {
    padding: 8px;
    border: 1px solid #ff1744;
    border-radius: 9px;
    background: #090910eF;
}

#controls {
    position: absolute;
    z-index: 3;
    bottom: max(12px, env(safe-area-inset-bottom));
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 8px;
}

.control {
    padding: 13px 15px;
    color: white;
    background: #160b1aee;
    border: 1px solid #ff1744;
    border-radius: 12px;
    font-weight: bold;
}

#message {
    position: absolute;
    z-index: 2;
    top: 42%;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 23px;
    font-weight: bold;
    text-shadow: 0 0 15px red;
    pointer-events: none;
}

#panel {
    display: none;
    position: absolute;
    z-index: 5;
    inset: 0;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: #000d;
}

.panelBox {
    width: 100%;
    max-width: 350px;
    padding: 24px 16px;
    text-align: center;
    background: #11111b;
    border: 2px solid #ff1744;
    border-radius: 22px;
}

.smallText {
    color: #ccc;
    font-size: 14px;
    line-height: 2;
}

@media (max-height: 550px) {
    #menu {
        padding-top: 8px;
    }

    .menuBox {
        padding: 12px;
    }

    .logo {
        margin-bottom: 5px;
    }

    .subtitle {
        margin-bottom: 8px;
    }

    .btn {
        padding: 10px;
        margin: 7px auto;
    }

    .version {
        margin-top: 8px;
    }
}
</style>
</head>

<body>

<!-- منوی اصلی -->

<section id="menu" class="screen">

    <div class="menuBox">

        <div class="logo">💻 nikanbot ☠️</div>

        <div class="subtitle">
            🔥 DARK SHOOTER<br>
            به میدان نبرد خوش آمدی!
        </div>

        <button class="btn" onclick="startGame()">
            🔫 شروع عملیات
        </button>

        <button class="btn" onclick="openSettings()">
            ⚙️ تنظیمات
        </button>

        <button class="btn gray" onclick="openAbout()">
            ☠️ درباره بازی
        </button>

        <div class="version">
            NIKANBOT DARK SHOOTER<br>
            VERSION 2.1
        </div>

    </div>

</section>

<!-- بازی -->

<section id="game" class="screen">

    <canvas id="arena"></canvas>

    <div id="hud">
        <div class="hudBox">❤️ <span id="health">100</span></div>
        <div class="hudBox">🎯 <span id="score">0</span></div>
        <div class="hudBox">⚡ مرحله <span id="level">1</span></div>
    </div>

    <div id="message"></div>

    <div id="controls">
        <button class="control" id="leftBtn">◀ چپ</button>
        <button class="control" id="fireBtn">🔫 شلیک</button>
        <button class="control" id="rightBtn">راست ▶</button>
        <button class="control" onclick="backToMenu()">🏠</button>
    </div>

    <div id="panel">
        <div class="panelBox">
            <h2 id="panelTitle">پایان بازی</h2>
            <p id="panelText" class="smallText"></p>
            <button class="btn" onclick="startGame()">🔄 بازی دوباره</button>
            <button class="btn gray" onclick="backToMenu()">🏠 منوی اصلی</button>
        </div>
    </div>

</section>

<!-- تنظیمات -->

<section id="settings" class="screen">
    <div class="menuBox">
        <div class="logo">⚙️ تنظیمات</div>

        <button class="btn" onclick="toggleSound()">
            🔊 صدا: <span id="soundLabel">روشن</span>
        </button>

        <button class="btn gray" onclick="showScreen('menu')">
            ↩️ برگشت
        </button>
    </div>
</section>

<!-- درباره بازی -->

<section id="about" class="screen">
    <div class="menuBox">
        <div class="logo">☠️ درباره بازی</div>

        <p class="smallText">
            💻 nikanbot DARK SHOOTER<br>
            بازی تیراندازی آرکید<br>
            ساخته‌شده با HTML، CSS و JavaScript<br><br>
            🔥 دشمن‌ها را شکست بده.<br>
            ⚡ رکوردت را افزایش بده.<br>
            👹 مراقب غول آخر باش!
        </p>

        <button class="btn gray" onclick="showScreen('menu')">
            ↩️ برگشت
        </button>
    </div>
</section>

<script>
const $ = id => document.getElementById(id);

const canvas = $("arena");
const ctx = canvas.getContext("2d");

let W = innerWidth;
let H = innerHeight;

let running = false;
let score = 0;
let health = 100;
let level = 1;
let soundOn = true;

let player;
let enemies = [];
let bullets = [];
let enemyBullets = [];
let particles = [];
let boss = null;

let lastTime = 0;
let spawnTimer = 0;
let fireTimer = 0;
let gameFrame = 0;

let moveLeft = false;
let moveRight = false;
let firing = false;

function resize() {
    W = innerWidth;
    H = innerHeight;

    const dpr = Math.min(devicePixelRatio || 1, 2);

    canvas.width = Math.floor(W * dpr);
    canvas.height = Math.floor(H * dpr);

    canvas.style.width = W + "px";
    canvas.style.height = H + "px";

    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    if (player) {
        player.x = Math.max(22, Math.min(W - 22, player.x));
        player.y = H - 100;
    }
}

addEventListener("resize", resize);
resize();

function showScreen(id) {
    document.querySelectorAll(".screen").forEach(el => {
        el.style.display = "none";
    });

    const el = $(id);
    el.style.display = "flex";

    if (id === "game") {
        el.style.display = "block";
    }
}

function openSettings() {
    showScreen("settings");
}

function openAbout() {
    showScreen("about");
}

function toggleSound() {
    soundOn = !soundOn;
    $("soundLabel").textContent = soundOn ? "روشن" : "خاموش";
    playSound(500);
}

function playSound(freq = 450) {
    if (!soundOn) return;

    try {
        const AC = window.AudioContext || window.webkitAudioContext;
        const ac = new AC();
        const osc = ac.createOscillator();
        const gain = ac.createGain();

        osc.type = "square";
        osc.frequency.value = freq;
        gain.gain.value = 0.025;

        osc.connect(gain);
        gain.connect(ac.destination);

        osc.start();

        gain.gain.exponentialRampToValueAtTime(
            0.001, ac.currentTime + 0.08
        );

        osc.stop(ac.currentTime + 0.08);
        osc.onended = () => ac.close();
    } catch (e) {}
}

function startGame() {
    showScreen("game");

    $("panel").style.display = "none";

    score = 0;
    health = 100;
    level = 1;

    enemies = [];
    bullets = [];
    enemyBullets = [];
    particles = [];
    boss = null;

    spawnTimer = 0;
    fireTimer = 0;
    gameFrame = 0;

    player = {
        x: W / 2,
        y: H - 100,
        speed: 5
    };

    running = true;
    lastTime = performance.now();

    $("message").textContent = "🔥 عملیات شروع شد!";
    updateHUD();

    playSound(700);

    setTimeout(() => {
        if (running) $("message").textContent = "";
    }, 1200);

    requestAnimationFrame(loop);
}

function backToMenu() {
    running = false;
    moveLeft = false;
    moveRight = false;
    firing = false;
    showScreen("menu");
    $("panel").style.display = "none";
}

function updateHUD() {
    $("health").textContent = Math.max(0, Math.ceil(health));
    $("score").textContent = score;
    $("level").textContent = level;
}

function shoot() {
    if (!running) return;

    bullets.push({
        x: player.x,
        y: player.y - 20,
        speed: 9
    });

    playSound(600);
}

function spawnEnemy() {
    if (!boss && level % 5 === 0 && score >= level * 100 - 100) {
        boss = {
            x: W / 2,
            y: 110,
            hp: 40,
            maxHp: 40,
            dir: 1,
            fire: 0
        };

        $("message").textContent = "👹 غول آخر!";

        setTimeout(() => {
            if (running) $("message").textContent = "";
        }, 1500);

        return;
    }

    enemies.push({
        x: 25 + Math.random() * Math.max(1, W - 50),
        y: -25,
        speed: 1.5 + Math.random() * 1.5 + level * .1,
        size: 16 + Math.random() * 6,
        hp: 1
    });
}

function burst(x, y, color) {
    for (let i = 0; i < 10; i++) {
        const a = Math.random() * Math.PI * 2;
        const s = 1 + Math.random() * 4;

        particles.push({
            x, y,
            vx: Math.cos(a) * s,
            vy: Math.sin(a) * s,
            life: 30,
            color
        });
    }
}

function endGame(won) {
    if (!running) return;

    running = false;

    $("panelTitle").textContent =
        won ? "🏆 پیروزی!" : "💀 بازی تمام شد";

    $("panelText").innerHTML =
        "امتیاز: <b>" + score + "</b><br>" +
        "مرحله: <b>" + level + "</b>";

    $("panel").style.display = "flex";
}

function loop(now) {
    if (!running) return;

    const dt = Math.min((now - lastTime) / 16.67, 2);
    lastTime = now;

    update(dt);
    draw();

    if (running) requestAnimationFrame(loop);
}

function update(dt) {
    gameFrame += dt;

    if (moveLeft) player.x -= player.speed * dt;
    if (moveRight) player.x += player.speed * dt;

    player.x = Math.max(20, Math.min(W - 20, player.x));

    fireTimer -= dt;

    if (firing && fireTimer <= 0) {
        shoot();
        fireTimer = 9;
    }

    spawnTimer -= dt;

    if (spawnTimer <= 0) {
        spawnEnemy();
        spawnTimer = Math.max(22, 65 - level * 3);
    }

    level = Math.floor(score / 100) + 1;

    bullets.forEach(b => b.y -= b.speed * dt);
    bullets = bullets.filter(b => b.y > -20);

    for (const e of enemies) {
        e.y += e.speed * dt;
        e.x += Math.sin(gameFrame * .05) * dt;

        if (Math.hypot(e.x - player.x, e.y - player.y) < e.size + 12) {
            e.y = H + 100;
            health -= 12;
        } else if (e.y > H) {
            e.y = H + 100;
            health -= 5;
        }
    }

    for (const b of bullets) {
        for (const e of enemies) {
            if (e.hp <= 0) continue;

            if (Math.hypot(b.x - e.x, b.y - e.y) < e.size + 6) {
                e.hp = 0;
                b.y = -100;
                score += 10;
                burst(e.x, e.y, "#ff1744");
                break;
            }
        }
    }

    enemies = enemies.filter(e => e.hp > 0 && e.y < H + 30);

    if (boss) {
        boss.x += boss.dir * 2 * dt;

        if (boss.x > W - 45) boss.dir = -1;
        if (boss.x < 45) boss.dir = 1;

        boss.fire -= dt;

        if (boss.fire <= 0) {
            enemyBullets.push({
                x: boss.x,
                y: boss.y + 25,
                speed: 3,
                size: 7
            });

            boss.fire = 45;
        }

        for (const b of bullets) {
            if (Math.hypot(b.x - boss.x, b.y - boss.y) < 42) {
                boss.hp--;
                b.y = -100;
                burst(boss.x, boss.y, "#bb00ff");

                if (boss.hp <= 0) {
                    score += 250;
                    burst(boss.x, boss.y, "#ff1744");
                    boss = null;
                    endGame(true);
                    return;
                }
            }
        }
    }

    for (const b of enemyBullets) {
        b.y += b.speed * dt;

        if (Math.hypot(b.x - player.x, b.y - player.y) < b.size + 12) {
            b.y = H + 100;
            health -= 8;
        }
    }

    enemyBullets = enemyBullets.filter(b => b.y < H + 20);

    for (const p of particles) {
        p.x += p.vx * dt;
        p.y += p.vy * dt;
        p.life -= dt;
    }

    particles = particles.filter(p => p.life > 0);

    if (health <= 0) {
        health = 0;
        updateHUD();
        endGame(false);
        return;
    }

    updateHUD();
}

function draw() {
    ctx.clearRect(0, 0, W, H);

    ctx.fillStyle = "#080810";
    ctx.fillRect(0, 0, W, H);

    ctx.strokeStyle = "#ff174415";

    for (let x = 0; x < W; x += 40) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, H);
        ctx.stroke();
    }

    for (let y = (gameFrame * 1.5) % 40; y < H; y += 40) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(W, y);
        ctx.stroke();
    }

    // بازیکن
    ctx.save();
    ctx.translate(player.x, player.y);
    ctx.shadowBlur = 20;
    ctx.shadowColor = "#00eaff";
    ctx.fillStyle = "#00d9ff";

    ctx.beginPath();
    ctx.moveTo(0, -22);
    ctx.lineTo(18, 17);
    ctx.lineTo(0, 10);
    ctx.lineTo(-18, 17);
    ctx.closePath();
    ctx.fill();

    ctx.restore();

    // گلوله‌ها
    ctx.fillStyle = "#00ffff";
    ctx.shadowBlur = 12;
    ctx.shadowColor = "#00ffff";

    for (const b of bullets) {
        ctx.fillRect(b.x - 2, b.y - 8, 4, 15);
    }

    // دشمن‌ها
    ctx.shadowColor = "#ff1744";

    for (const e of enemies) {
        ctx.fillStyle = "#ff1744";
        ctx.beginPath();
        ctx.moveTo(e.x, e.y + e.size);
        ctx.lineTo(e.x - e.size, e.y - e.size);
        ctx.lineTo(e.x + e.size, e.y - e.size);
        ctx.closePath();
        ctx.fill();
    }

    // غول آخر
    if (boss) {
        ctx.fillStyle = "#9700ff";
        ctx.shadowColor = "#bb00ff";

        ctx.beginPath();
        ctx.arc(boss.x, boss.y, 35, 0, Math.PI * 2);
        ctx.fill();

        const bw = Math.min(220, W - 50);
        const bx = (W - bw) / 2;

        ctx.shadowBlur = 0;
        ctx.fillStyle = "#333";
        ctx.fillRect(bx, 60, bw, 8);

        ctx.fillStyle = "#ff1744";
        ctx.fillRect(bx, 60, bw * Math.max(0, boss.hp / boss.maxHp), 8);
    }

    // گلوله‌های دشمن
    ctx.fillStyle = "#ff00ff";
    ctx.shadowColor = "#ff00ff";

    for (const b of enemyBullets) {
        ctx.beginPath();
        ctx.arc(b.x, b.y, b.size, 0, Math.PI * 2);
        ctx.fill();
    }

    // انفجارها
    ctx.shadowBlur = 0;

    for (const p of particles) {
        ctx.globalAlpha = Math.max(0, p.life / 30);
        ctx.fillStyle = p.color;
        ctx.fillRect(p.x, p.y, 4, 4);
    }

    ctx.globalAlpha = 1;
}

function bindHold(id, setter) {
    const el = $(id);

    el.addEventListener("pointerdown", e => {
        e.preventDefault();
        setter(true);
    });

    function stop(e) {
        e.preventDefault();
        setter(false);
    }

    el.addEventListener("pointerup", stop);
    el.addEventListener("pointercancel", stop);
    el.addEventListener("pointerleave", stop);
}

bindHold("leftBtn", v => moveLeft = v);
bindHold("rightBtn", v => moveRight = v);
bindHold("fireBtn", v => firing = v);

canvas.addEventListener("pointerdown", e => {
    if (!running) return;

    if (e.clientY < H * .65) {
        shoot();
    } else if (e.clientX < W / 2) {
        moveLeft = true;
    } else {
        moveRight = true;
    }
});

canvas.addEventListener("pointerup", () => {
    moveLeft = false;
    moveRight = false;
});

canvas.addEventListener("pointercancel", () => {
    moveLeft = false;
    moveRight = false;
});

addEventListener("keydown", e => {
    if (e.key === "ArrowLeft" || e.key.toLowerCase() === "a") {
        moveLeft = true;
    }

    if (e.key === "ArrowRight" || e.key.toLowerCase() === "d") {
        moveRight = true;
    }

    if (e.code === "Space") {
        e.preventDefault();
        firing = true;
    }
});

addEventListener("keyup", e => {
    if (e.key === "ArrowLeft" || e.key.toLowerCase() === "a") {
        moveLeft = false;
    }

    if (e.key === "ArrowRight" || e.key.toLowerCase() === "d") {
        moveRight = false;
    }

    if (e.code === "Space") {
        firing = false;
    }
});

showScreen("menu");
</script>

</body>
</html>
